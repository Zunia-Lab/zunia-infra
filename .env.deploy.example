####################################################################################
# zunia-infra — deployment credential template
#
# Copy to `.env.deploy` and fill in. `.env.deploy` is git-ignored and MUST NEVER
# be committed, pasted into an issue/PR, or uploaded anywhere.
#
#   cp .env.deploy.example .env.deploy && chmod 600 .env.deploy
#
# Rules
#   - This template (`.env.deploy.example`) keeps every value EMPTY. Real values
#     live only in `.env.deploy` locally and in the platform secret store
#     (GitHub Actions secrets / Vercel env / Pulumi config / 1Password / Doppler).
#   - Never put key material (mnemonics, user private keys) in here. This file is
#     for *infrastructure* credentials only.
#   - Multi-line values (SSH keys, service-account JSON, .p8) belong in a file
#     outside the repo; reference them here by absolute path, or base64-encode
#     them into a single line.
#   - Rotate anything that has ever been echoed to a terminal recording, chat, or
#     CI log. Treat a leak as a full rotation, not a redaction.
#
# Load it in a shell (never `git add` it):
#   set -a && . ./.env.deploy && set +a
####################################################################################


####################################################################################
# 1. Global / meta
####################################################################################

# One of: dev | staging | prod
ZUNIA_ENV=
# Short git sha or tag being deployed (usually injected by CI)
ZUNIA_RELEASE=
# Owning GitHub org
ZUNIA_GITHUB_ORG=Zunia-Lab


####################################################################################
# 2. Domains and DNS (see ../DEPLOY.md for the record table)
####################################################################################

ZUNIA_APEX_DOMAIN=zunialab.com
ZUNIA_WWW_HOSTNAME=www.zunialab.com
ZUNIA_DOCS_HOSTNAME=docs.zunialab.com
ZUNIA_WALLET_HOSTNAME=wallet.zunialab.com
ZUNIA_API_HOSTNAME=api.zunialab.com
ZUNIA_LINK_HOSTNAME=link.zunialab.com
ZUNIA_STATUS_HOSTNAME=status.zunialab.com
ZUNIA_REGISTRY_HOSTNAME=

# Values Vercel/host asks you to point at
VERCEL_APEX_A_RECORD=76.76.21.21
VERCEL_CNAME_TARGET=cname.vercel-dns.com
# Backend/worker hostname that `api.` should CNAME to
BACKEND_ORIGIN_HOSTNAME=


####################################################################################
# 3. Cloudflare (DNS, proxy, WAF, R2, Pages, Workers, Turnstile)
####################################################################################

# Account → Manage Account → Account ID
CLOUDFLARE_ACCOUNT_ID=
# Zone → Overview → Zone ID (for zunialab.com)
CLOUDFLARE_ZONE_ID=
# Scoped API token (preferred). Perms: Zone:DNS:Edit, Zone:Zone:Read,
# Zone:Cache Purge, Account:Workers Scripts:Edit, Account:R2:Edit as needed.
CLOUDFLARE_API_TOKEN=
# Legacy global key + email — only if a tool cannot use a scoped token
CLOUDFLARE_EMAIL=
CLOUDFLARE_GLOBAL_API_KEY=

# Alias some tools expect
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# Wrangler (Workers / Pages)
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_WORKER_NAME=
WRANGLER_SEND_METRICS=false

# R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# Turnstile (bot protection on public forms)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Access / Tunnel (if admin surfaces sit behind it)
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=


####################################################################################
# 4. Vercel (website, docs, dashboard)
####################################################################################

# Account Settings → Tokens
VERCEL_TOKEN=
# Team/personal scope id (`vercel teams ls`, or .vercel/project.json)
VERCEL_ORG_ID=
VERCEL_TEAM_SLUG=

# One project id per app (Project Settings → General → Project ID)
VERCEL_PROJECT_ID_WEBSITE=
VERCEL_PROJECT_ID_DOCS=
VERCEL_PROJECT_ID_DASHBOARD=

# Deploy hooks (Project Settings → Git → Deploy Hooks)
VERCEL_DEPLOY_HOOK_WEBSITE=
VERCEL_DEPLOY_HOOK_DOCS=
VERCEL_DEPLOY_HOOK_DASHBOARD=

# Protects scheduled routes; must match the header your cron sends
CRON_SECRET=
# Short-lived JWT provisioned by `vercel env pull` — do not hand-write
VERCEL_OIDC_TOKEN=
# Only if you opt out of OIDC for the AI Gateway
AI_GATEWAY_API_KEY=


####################################################################################
# 5. Pulumi (this repo + zunia-chain-registry/pulumi)
####################################################################################

# app.pulumi.com → Settings → Access Tokens
PULUMI_ACCESS_TOKEN=
# Passphrase for locally-encrypted stack secrets
PULUMI_CONFIG_PASSPHRASE=
# Or read it from a file instead of the env var
PULUMI_CONFIG_PASSPHRASE_FILE=
# Self-managed backend, e.g. s3://... / gs:// / file://~/.pulumi
PULUMI_BACKEND_URL=
PULUMI_STACK=
PULUMI_SKIP_UPDATE_CHECK=true


####################################################################################
# 6. Always-on container hosts (realtime / indexer WS worker)
#    ADR: zunia-indexer/docs/adr/0003-realtime-worker-host.md
####################################################################################

# --- Fly.io ---
FLY_API_TOKEN=
FLY_APP_INDEXER=
FLY_APP_REALTIME=
FLY_APP_BACKEND=
FLY_REGION=

# --- Railway ---
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=

# --- Render ---
RENDER_API_KEY=
RENDER_SERVICE_ID_INDEXER=
RENDER_SERVICE_ID_BACKEND=
RENDER_DEPLOY_HOOK_URL=

# --- Generic container runtime tuning ---
APP_PORT=8787
HEALTHCHECK_PATH=/health
LOG_LEVEL=info


####################################################################################
# 7. Container registry / image build
####################################################################################

# ghcr.io | docker.io | registry.fly.io
CONTAINER_REGISTRY=ghcr.io
CONTAINER_REGISTRY_USERNAME=
# GHCR: a PAT with write:packages
CONTAINER_REGISTRY_TOKEN=
CONTAINER_IMAGE_INDEXER=
CONTAINER_IMAGE_BACKEND=
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Image signing (cosign)
COSIGN_PRIVATE_KEY_PATH=
COSIGN_PASSWORD=


####################################################################################
# 8. SSH / VPS / bare metal
####################################################################################

DEPLOY_SSH_HOST=
DEPLOY_SSH_IP=
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=
# Absolute path OUTSIDE this repo, e.g. ~/.ssh/zunia_deploy_ed25519
DEPLOY_SSH_KEY_PATH=
DEPLOY_SSH_KEY_PASSPHRASE=
# For CI: base64 of the private key (`base64 -w0 < key`), never the raw PEM
DEPLOY_SSH_PRIVATE_KEY_B64=
# Pin the host: `ssh-keyscan -p 22 host`
DEPLOY_SSH_KNOWN_HOSTS=
DEPLOY_TARGET_PATH=
# Optional bastion
BASTION_HOST=
BASTION_USER=
BASTION_SSH_KEY_PATH=

# sudo password on the target, if unavoidable (prefer NOPASSWD for the deploy user)
DEPLOY_SUDO_PASSWORD=


####################################################################################
# 9. GitHub (CI, releases, org automation)
####################################################################################

# Classic/fine-grained PAT: repo, workflow, write:packages, read:org
GH_TOKEN=
GITHUB_TOKEN=
# GitHub App (preferred over PAT for org automation)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY_B64=
# Webhook receiver shared secret
GITHUB_WEBHOOK_SECRET=
# Read-only deploy key for private submodule/registry pulls
GITHUB_DEPLOY_KEY_PATH=


####################################################################################
# 10. Databases (Neon Postgres + Upstash Redis via Vercel Marketplace)
####################################################################################

# Pooled connection used by the app at runtime
DATABASE_URL=
# Direct (non-pooled) connection for migrations
DATABASE_URL_UNPOOLED=
DATABASE_SSL_MODE=require
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Neon control plane (branching, ephemeral preview DBs)
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH=

# Redis / event bus for notification fan-out
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_PASSWORD=

# Backups
DB_BACKUP_BUCKET=
DB_BACKUP_ENCRYPTION_KEY=


####################################################################################
# 11. Other object storage / backup targets (optional)
####################################################################################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=


####################################################################################
# 12. Backend application secrets (zunia-backend)
####################################################################################

# `openssl rand -hex 32` for each; independent values, never reused
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=
# Encrypts data at rest in the backend DB (NOT user wallet keys)
ENCRYPTION_KEY=
# Comma-separated allowed origins
CORS_ALLOWED_ORIGINS=
# Shared secret between dashboard/website and the backend
INTERNAL_API_KEY=
RATE_LIMIT_REDIS_URL=


####################################################################################
# 13. Indexer (zunia-indexer)
####################################################################################

INDEXER_API_URL=
# Shared secret clients/backend proxy must present
INDEXER_API_KEY=
INDEXER_FIRST_CONNECT_LIMIT=5
INDEXER_MAX_TXS_PER_WALLET=50
PORT=8787
REALTIME_ENABLED=true
# poll | ws | hybrid
REALTIME_MODE=hybrid
REALTIME_POLL_INTERVAL_SEC=60
REALTIME_LOG_NOTIFY=false
VERCEL_QUEUE_ENABLED=false
REALTIME_QUEUE_TOPIC=zunia-tx-events


####################################################################################
# 14. Push notifications (zunia-backend)
####################################################################################

# Web Push — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@zunialab.com

# Firebase Cloud Messaging (Android + fallback)
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_PATH=
FCM_SERVICE_ACCOUNT_JSON_B64=

# Apple Push Notification service
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_AUTH_KEY_P8_PATH=
APNS_AUTH_KEY_P8_B64=
# production | sandbox
APNS_ENVIRONMENT=production

# Optional third-party fan-out (adds a party to the privacy story — see PRE-DEVELOPMENT §4.3)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=


####################################################################################
