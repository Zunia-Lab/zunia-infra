[Unit]
Description=Zunia backend and Connect relay
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=zunia
Group=zunia
WorkingDirectory=/srv/zunia/repos/zunia-backend
Environment=PATH=/srv/zunia/toolchain/node/bin:/usr/bin:/bin
EnvironmentFile=/srv/zunia/shared/backend.env
ExecStart=/srv/zunia/toolchain/node/bin/node dist/src/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
