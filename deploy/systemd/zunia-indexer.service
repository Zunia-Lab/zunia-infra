[Unit]
Description=Zunia indexer
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=zunia
Group=zunia
WorkingDirectory=/srv/zunia/repos/zunia-indexer
Environment=PATH=/srv/zunia/toolchain/node/bin:/usr/bin:/bin
EnvironmentFile=/srv/zunia/shared/indexer.env
ExecStart=/srv/zunia/toolchain/node/bin/node dist/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
